<?xml version='1.0' encoding='UTF-8'?>
<routes>
    <!-- Vehicle Types -->
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5" maxSpeed="13.89" guiShape="passenger" color="30,144,255" />
    <vType id="ambulance" accel="3.0" decel="5.0" sigma="0.5" length="5" maxSpeed="16.67" vClass="emergency" color="255,0,0" guiShape="passenger" />

    <!-- Four Traffic Routes -->
    <route id="north_south" edges="N_in S_out" />
    <route id="south_north" edges="S_in N_out" />
    <route id="east_west" edges="E_in W_out" />
    <route id="west_east" edges="W_in E_out" />

    <!-- Continuous Random Passenger Traffic: Arterial (NS/SN: ~240 veh/hr) & Cross-street (EW/WE: ~120 veh/hr) -->
    <!-- Non-stop flows up to 24 hours (86400s) with independent Bernoulli arrivals per second -->
    <flow id="flow_NS" type="car" route="north_south" begin="0" end="86400" probability="0.066667" />
    <flow id="flow_SN" type="car" route="south_north" begin="0" end="86400" probability="0.066667" />
    <flow id="flow_EW" type="car" route="east_west"   begin="0" end="86400" probability="0.033333" />
    <flow id="flow_WE" type="car" route="west_east"   begin="0" end="86400" probability="0.033333" />

    <!-- Continuous Random Emergency Ambulances from all 4 directions -->
    <!-- Probabilistic generation: ambulances arrive stochastically across all directions non-stop -->
    <flow id="flow_amb_NS" type="ambulance" route="north_south" begin="0" end="86400" probability="0.003333" />
    <flow id="flow_amb_SN" type="ambulance" route="south_north" begin="0" end="86400" probability="0.003333" />
    <flow id="flow_amb_EW" type="ambulance" route="east_west"   begin="0" end="86400" probability="0.002500" />
    <flow id="flow_amb_WE" type="ambulance" route="west_east"   begin="0" end="86400" probability="0.002500" />
</routes>
